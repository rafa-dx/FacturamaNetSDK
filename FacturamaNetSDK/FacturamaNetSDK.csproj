<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>netstandard2.0;net8.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!-- Fijado explícitamente: netstandard2.0 usaría C# 7.3 por defecto (donde ni Nullable
         compila) y net8.0 usaría C# 12. Un solo LangVersion garantiza que ambos TFMs
         compilen el mismo código y no divergir por target. -->
    <LangVersion>10.0</LangVersion>

    <!-- Analizadores: CA2007 (ConfigureAwait) y CA2016 (propagar CancellationToken)
         se elevan a error en .editorconfig para que no vuelvan a colarse en la librería -->
    <EnableNETAnalyzers>true</EnableNETAnalyzers>

    <!-- Documentación XML: expone los /// al IntelliSense del consumidor y a herramientas/IA -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Temporal: silencia CS1591 mientras se completa la cobertura de XML docs en modelos (Fase 4) -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>

    <!-- Metadatos de paquete NuGet -->
    <PackageId>FacturamaNetSDK</PackageId>
    <Version>1.0.0</Version>
    <Authors>Rafael Dorantes</Authors>
    <Company>Rafael Dorantes</Company>
    <Description>SDK en .NET para consumir la API de facturación electrónica de Facturama (CFDI 4.0, México). Cubre CFDI (API Web y Lite), clientes, catálogos del SAT y retenciones, con resiliencia (Polly) y manejo de excepciones tipadas.</Description>
    <PackageTags>facturama;cfdi;sat;factura;facturacion;mexico;invoice;electronic-invoice</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Copyright (c) 2026 Rafael Dorantes</Copyright>
    <RepositoryType>git</RepositoryType>
    <!-- TODO antes de publicar: agregar
         <RepositoryUrl>https://github.com/USUARIO/FacturamaNetSDK</RepositoryUrl>
         <PackageProjectUrl>https://github.com/USUARIO/FacturamaNetSDK</PackageProjectUrl> -->
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http.Polly" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.0" />
    <PackageReference Include="Polly" Version="7.2.4" />
  </ItemGroup>

  <!-- En net8.0 System.Text.Json viene en el framework compartido; en netstandard2.0 hay que
       traerlo como paquete. 8.0.6 es la última 8.x parcheada (las <8.0.5 arrastran CVE-2024-43485). -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.0.6" />
  </ItemGroup>

  <!-- Expone los tipos internal (p.ej. FacturamaHttpClient) al proyecto de pruebas -->
  <ItemGroup>
    <InternalsVisibleTo Include="FacturamaNetSDK.Tests" />
  </ItemGroup>

</Project>
